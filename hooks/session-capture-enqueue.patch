Wire the SessionEnd hook to the detached ingest enqueue.

Two lines against session-capture.mjs 1.0.0 (sha of the 2026-09-09 deployed
copy in ~/.claude/hooks): one import, and one call placed immediately after the
note is written successfully. Nothing else in the hook changes, so this applies
cleanly on top of W-H1's restructure by hand if the line numbers have moved.

The import is relative to the hook itself, so it resolves both at the deployed
location (~/.claude/hooks/lib/enqueue-ingest.mjs) and in the repo layout
(hooks/lib/enqueue-ingest.mjs). See hooks/README.md.

--- a/session-capture.mjs
+++ b/session-capture.mjs
@@ -28,6 +28,7 @@
 import fs from 'node:fs';
 import os from 'node:os';
 import path from 'node:path';
+import { enqueueIngest } from './lib/enqueue-ingest.mjs';

 const DEADLINE = Date.now() + 1200; // ms budget; optional work stops after this
 const VERSION = '1.0.0';
@@ -636,6 +637,8 @@
   try {
     fs.mkdirSync(targetDir, { recursive: true });
     fs.writeFileSync(file, note, 'utf8');
   } catch (err) {
     log(`skip ${sessionId}: write failed (${err?.code || err?.message || 'unknown'}) -> ${file}`);
     return;
   }

+  enqueueIngest({ vaultRoot, notePath: file, log });
+
   log(
     `wrote ${area}/${collection}/sessions/${path.basename(file)} ` +
       `prompts=${prompts.length} files=${acc.files.size} cmds=${acc.commandCount} ` +
       `ms=${Date.now() - (DEADLINE - 1200)}`,
   );
 }
