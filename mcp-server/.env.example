# Copy to .env for local runs, or set these in the `env` block of the MCP
# server entry in ~/.claude/settings.json. NEVER commit a filled-in .env.
#
# This server does not read .env itself — the MCP client passes the env block
# through. The file exists to document the variables and for `node --env-file`.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Direct Postgres connection to the harness-memory project (hqkytnyiiuxovnnyixye).
# Supabase dashboard > Project Settings > Database > Connection string.
# Must be the postgres/service role: RLS is enabled on schema `rag` with no
# policies, so anon and authenticated read nothing.
#
# ⚠ MUST be harness-memory, never bb2dash (goultdzqcavefcgnifdy). bb2dash holds
# a separate class-materials store embedded with gte-small — also 384-dim, so
# querying it with bge vectors returns confidently-ranked nonsense with NO
# error. The server refuses a bb2dash URL outright, but nothing catches a third
# database you point it at.
#
# The PostgREST path (SUPABASE_URL + SUPABASE_SERVICE_ROLE) is NOT supported:
# schema `rag` is not exposed and returns 406 PGRST106.
DATABASE_URL=postgresql://<user>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------

# Supabase's pooler presents a certificate from a private CA. Pin it so TLS
# verification stays ON. Use a Windows-style path — Node cannot read /c/... .
DATABASE_CA_CERT=C:/Users/estac/agentic-harness/certs/prod-ca.crt

# Where fastembed caches the ONNX model (~130 MB, downloaded on first search).
# Keep it outside OneDrive.
FASTEMBED_CACHE_DIR=C:/Users/estac/agentic-harness/mcp-server/.fastembed-cache

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Set to "disable" for a local Postgres with no TLS. There is deliberately no
# option to keep TLS on but skip verification.
# DATABASE_SSL=disable

# Fully-qualified pgvector type. Supabase installs it in `extensions`.
# RAG_VECTOR_TYPE=extensions.vector

# Result-count tuning.
# RAG_DEFAULT_MATCH_COUNT=10
# RAG_MAX_MATCH_COUNT=50

# Chunks per document in one result set. Stops one long document crowding out
# every other source.
# RAG_MAX_PER_DOCUMENT=3

# Cosine floor on the semantic arm. On this corpus relevant hits score
# 0.79-0.87 and unrelated queries 0.48-0.66, so 0.70 makes an off-topic query
# correctly return nothing. Set to "none" to remove the floor entirely.
# RAG_MIN_SIMILARITY=0.70

# RRF constant passed to rag.search(). Keep it aligned with any other client.
# RAG_RRF_K=60

# Instruction prefix prepended to queries before embedding. Leave unset.
# Project convention is NO prefix on either side; setting it here without
# re-embedding the store would break parity silently.
# RAG_QUERY_PREFIX=
