# Copy to .env and fill in. .env is gitignored — never commit real values,
# and never print one to a log or a terminal.
#
# Supabase project: hqkytnyiiuxovnnyixye (harness-memory), region us-east-1.
# This repo owns the `rag` schema in THAT project. It stores session histories,
# tagged by `collection` (a project or class name).
#
# ---------------------------------------------------------------------------
# TWO STORES EXIST. DO NOT CROSS THEM.
#
#   harness-memory  hqkytnyiiuxovnnyixye  session histories  bge-small-en-v1.5
#   bb2dash         goultdzqcavefcgnifdy  class materials    gte-small
#
# Both are 384-dimensional, so mixing them raises NO error — it silently
# returns confidently-ranked nonsense, because they are different vector
# spaces. bb2dash credentials live in C:/Users/estac/projects/bb2dash/.env,
# deliberately not here.
# ---------------------------------------------------------------------------
#
# Clients connect over DIRECT POSTGRES, not PostgREST. The `rag` schema is not
# exposed to the REST API, so a supabase-js / PostgREST RPC call cannot reach
# rag.search(). See docs/architecture.md.

# Direct Postgres connection — the only credential that matters here. Both the
# ingestion pipeline and the MCP server use it.
#
# Use the SESSION POOLER, not the direct host:
#   - direct  db.<ref>.supabase.co        AAAA-only; unreachable on IPv4 networks
#   - session aws-0-<region>.pooler...    :5432, IPv4, supports prepared statements
#   - txn     aws-0-<region>.pooler...    :6543, NO prepared statements — avoid
#
# Username for the pooler is postgres.<project-ref>, not plain postgres.
# Percent-encode special characters in the password: space %20, @ %40, # %23.
#
# postgresql://postgres.hqkytnyiiuxovnnyixye:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# TLS: Supabase signs with its own root CA, which is not in Node's or Python's
# default trust bundle. The cert is committed at certs/prod-ca.crt (it is public,
# not a secret) and covers every project in the org.
PGSSLROOTCERT=./certs/prod-ca.crt

# Optional. Local embedding model cache. Defaults to a system temp directory,
# which Windows cleans — pin it somewhere durable, and keep it OUT of OneDrive.
FASTEMBED_CACHE_DIR=

# Optional. BGE query instruction prefix. Project convention is EMPTY on both
# the ingestion and retrieval sides. Setting it on one side only degrades
# retrieval silently — change both or neither.
RAG_QUERY_PREFIX=
