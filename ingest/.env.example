# Reference only. The real values live in the gitignored .env at the REPO ROOT
# (C:/Users/estac/agentic-harness/.env), which the CLI finds automatically.
# Never commit real values. Never print them.

# Direct Postgres connection — the ONLY write path for ingestion.
# Supabase -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres

# Present in the repo .env and used by the MCP server. This package reads them
# so `ingest --check-env` can report them, but never sends them anywhere:
# the rag schema is NOT exposed to PostgREST (PGRST106), by design.
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE=sb_secret_REPLACE_ME
